# Python build artifacts — never part of the source tree.
__pycache__/
*.py[cod]
*.so

# Test/tooling caches
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
# .vscode holds two kinds of file. settings.json and friends are one
# person's preferences and stay out. launch.json and tasks.json are
# source: they set the working directory the package imports need, so
# the Run button works whether the app folder or the repository root
# was opened. A clone without them is a clone where Run fails, and
# tests/test_launch_environment.py checks they are here.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
Thumbs.db
.DS_Store

# Excel files written by Cable Web's own Export, and scratch solve output.
# The cableweb_report*.xlsx regression fixtures are deliberately NOT ignored
# (see MANIFESTO.md sec 2, checklist item 4) -- add them explicitly with
# `git add -f` if you keep them here.
~$*.xlsx
