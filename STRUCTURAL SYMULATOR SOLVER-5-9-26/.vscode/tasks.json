{
  // The same working-directory problem as launch.json: every task names
  // the app folder rather than trusting the workspace root, so these
  // work whichever folder was opened.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Doctor: can this interpreter run the app?",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["tools/doctor.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "tests/", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": {"kind": "test", "isDefault": true}
    },
    {
      "label": "Build the release (.rbz and .zip)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["tools/build_release.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
